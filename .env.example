# === KK AI Translator Environment Configuration ===
# Copy this file to .env and fill in your actual values

# === Common Settings ===
IMAGE_NAME=translator-api
ACI_NAME=translator-api-container-instance
PORT=5001

# === API Security ===
API_KEY=your-secure-api-key-here
ADMIN_SECRET=your-admin-secret-here

# === Azure Subscription IDs (optional) ===
SUBSCRIPTION_NONPROD=your-nonprod-subscription-id
SUBSCRIPTION_PROD=your-prod-subscription-id

# === Test Environment ===
TEST_AZURE_RG=your-test-resource-group
TEST_ACR_NAME=your-test-acr-name
TEST_APP_PLAN=your-test-app-plan
TEST_APP_NAME=your-test-app-name

# === Production Environment ===
PROD_AZURE_RG=your-prod-resource-group
PROD_ACR_NAME=your-prod-acr-name
PROD_APP_PLAN=your-prod-app-plan
PROD_APP_NAME=your-prod-app-name

# === Azure Speech Services ===
# Create Azure Speech Service in your preferred region  
MODEL_AZURE_SPEECH_URL=https://REGION.stt.speech.microsoft.com/speech/recognition/conversation/cognitiveservices/v1
AZURE_SPEECH_KEY=your-azure-speech-key
MODEL_AZURE_SPEECH_BILLING_URL=https://REGION.api.cognitive.microsoft.com/
AZURE_SPEECH_REGION=your-region

# === Azure OpenAI ===
# Create Azure OpenAI service and deploy gpt-4o-mini model
MODEL_AZURE_GPT4OMINI_URL=https://your-openai-service.openai.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2024-10-21
MODEL_AZURE_GPT35TURBO_URL=https://your-openai-service.openai.azure.com/openai/deployments/gpt-35-turbo-16k/chat/completions?api-version=0613
AZURE_OPENAI_KEY=your-azure-openai-key

# === External APIs (Optional) ===
PROMTE_WHISPER=https://applai.kalundborg.dk/api/v1/transcribe
PROMTE_4O=https://applai.kalundborg.dk/api/v1/generate
PROMTE_API_KEY=your-promte-api-key

# === Other Model URLs (Optional) ===
MODEL_OLLAMA_3_URL=https://your-ollama-endpoint/
MODEL_GPT35_URL=https://your-gpt35-endpoint/

# === Database Configuration ===
# Create Azure Database for MySQL
MYSQL_USER=your-mysql-username
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=your-server.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DB=your-database-name

# Full database connection string (URL-encode special characters in password)
# Example: mysql+pymysql://username:password@server.mysql.database.azure.com:3306/database?ssl_mode=REQUIRED
DATABASE_URL=mysql+pymysql://MYSQL_USER:MYSQL_PASSWORD@MYSQL_HOST:3306/MYSQL_DB?ssl_mode=REQUIRED

# === Azure Container Registry ===
# Get this after creating ACR: az acr credential show --name <acr-name> --query "passwords[0].value" --output tsv
AZURE_ACR_PASSWORD=your-acr-admin-password